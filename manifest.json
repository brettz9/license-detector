{
  "manifest_version": 3,
  "name": "License Detector",
  "version": "0.1.2",
  "description": "Detects the license of JavaScript running on the page and classifies it (permissive, copyleft, public domain, unlabeled, ...). Optional best-effort blocking of non-free/unlabeled scripts.",
  "icons": {
    "16": "src/icons/icon-neutral-16.png",
    "32": "src/icons/icon-neutral-32.png",
    "48": "src/icons/icon-neutral-48.png",
    "128": "src/icons/icon-neutral-128.png"
  },
  "action": {
    "default_title": "License Detector",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "src/icons/icon-neutral-16.png",
      "32": "src/icons/icon-neutral-32.png",
      "48": "src/icons/icon-neutral-48.png",
      "128": "src/icons/icon-neutral-128.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background/background.js",
    "scripts": ["src/background/background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["src/content/content-script.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "webRequest"
  ],
  "optional_permissions": [
    "webRequestBlocking",
    "webRequestFilterResponse"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "file:///*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "license-detector@brett-zamir.me",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
